# Supabase — the shared source of truth for the demo.
# Both apps point at the same project on purpose: that is the whole point.
# The publishable (anon) key is safe in a client; it can only read, and every write
# goes through the security-definer functions in supabase/migrations/0002_rls_and_rpcs.sql.
VITE_SUPABASE_URL=https://cddbmhperspefefyibwz.supabase.co
VITE_SUPABASE_ANON_KEY=

# Real "Continue with Google" on the sign-up screen. Optional — with no client ID the
# button runs a short simulated connect instead, so the demo still works offline.
#   1. https://console.cloud.google.com/  ->  APIs & Services -> Credentials
#   2. Create credentials -> OAuth client ID -> Web application
#   3. Authorized JavaScript origins: http://localhost:8443 (plus any deployed origin)
VITE_GOOGLE_CLIENT_ID=
